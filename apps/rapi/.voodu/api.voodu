# The API, and the way in.
#
#   vd apply -f .voodu/api.voodu -r prod
#
# Build mode: the CLI tarballs this directory and the server builds the
# Dockerfile that is already here. No registry, no CI step that has to publish
# before a deploy can start.
#
# Nothing secret is in this file. Everything below reads from the controller:
#
#   vd config contagorda/api set \
#     DATABASE_URL="postgres://contagorda:PASSWORD@pg-0.contagorda:5432/contagorda_production" \
#     REDIS_URL="redis://cache-0.contagorda:6379/0" \
#     CORS_ORIGINS="https://app.contagorda.com" \
#     RAILS_MASTER_KEY="$(cat config/master.key)" \
#     CLOWK_PUBLISHABLE_KEY="pk_live_..." \
#     CLOWK_SECRET_KEY="sk_live_..." \
#     CLOWK_SUBDOMAIN_URL="https://contagorda.clowk.dev"

deployment "contagorda" "api" {
  # One replica. Five threads in one Puma worker answer five requests at once,
  # which is past what a household generates — the second replica was buying
  # continuity during a deploy, not capacity.
  #
  # The cost is that a deploy has a gap: the new pod has to pass its startup
  # probe before it takes traffic, and there is no old one still answering. On a
  # Rails boot that is tens of seconds of 502. Acceptable for an app used by the
  # people deploying it; the day it is not, this is the line to change.
  replicas = 1

  build {
    context    = "."
    dockerfile = "Dockerfile"
  }

  # No `ports`. The ingress reaches the container over the container network, so
  # nothing needs publishing to the host — and 127.0.0.1:3000 there already
  # belongs to clowk, so publishing this one would fail to start rather than
  # fail to route.

  env = {
    RAILS_ENV = "production"

    # Thruster fronts Puma, and the two need different ports. Its defaults are
    # `HTTP_PORT=80` and `TARGET_PORT=3000`, and it starts Rails with `PORT` set
    # to the target — so moving only `HTTP_PORT` to 3000 would have both binding
    # 3000 and the container dying on "address already in use".
    HTTP_PORT   = "3000"
    TARGET_PORT = "3001"

    # Logs go to stdout, where `vd logs` can see them.
    RAILS_LOG_TO_STDOUT = "1"

    # Five threads in one worker: five requests at once, five database
    # connections. Both numbers matter — `max_connections` on the shared
    # Postgres is sized against this.
    RAILS_MAX_THREADS = "5"
    WEB_CONCURRENCY   = "1"
  }

  # Migrations run once per deploy, not once per replica. The image's entrypoint
  # also runs `db:prepare` on boot — Rails takes an advisory lock, so two
  # replicas starting together cannot collide — but doing it here means the
  # schema is already in place when the first one starts, instead of two pods
  # queueing behind the same lock.
  release {
    pre_command = ["bin/rails", "db:migrate"]
    timeout     = "5m"
  }

  probes {
    # Rails with bootsnap cold is not fast. Without this window the pod is
    # killed for failing a liveness check it was never going to pass yet.
    startup {
      http_get {
        path = "/up"
        port = 3000
      }
      period            = "5s"
      failure_threshold = 12
    }

    # Caddy follows readiness: a pod that stops passing this is taken out of
    # rotation instead of answering with errors.
    readiness {
      http_get {
        path = "/up"
        port = 3000
      }
      period = "10s"
    }

    liveness {
      http_get {
        path = "/up"
        port = 3000
      }
      period            = "30s"
      failure_threshold = 3
    }
  }

  # Measured against the neighbours rather than guessed: clowk sits at ~400Mi
  # and the PWA at ~12Mi on this same VM. One Puma worker with jemalloc (the
  # image preloads it) settles well under this; the headroom is for the boot,
  # where a Rails process is at its fattest.
  resources {
    limits {
      cpu    = "0.5"
      memory = "384Mi"
    }
  }
}

ingress "contagorda" "api" {
  host = "${API_HOST:-api.contagorda.com}"
  port = 3000

  # The PWA is served over https, so this has to be too: a page on https cannot
  # call http, and the browser refuses before the request leaves — with an error
  # that says nothing about CORS.
  #
  # The redirect for plain http comes from Rails (`force_ssl`), not from here.
  # The ingress serves :80 and :443 from one server, so a TLS host stays
  # reachable over http and simply answers — see production.rb.
  tls {
    email = "ops@contagorda.com"
  }
}

# An idempotency key is only useful for as long as a retry is plausible. Kept
# forever, a safety net becomes a table.
cronjob "contagorda" "sweep-idempotency-keys" {
  schedule = "17 4 * * *"
  timezone = "America/Sao_Paulo"

  # The image the deployment above just built, rather than a second build of the
  # same directory. Build mode tags `<scope>-<name>:latest`, and a nightly
  # sweep has no reason to make every deploy build twice.
  image = "contagorda-api:latest"

  command  = ["bin/rails", "runner", "IdempotencyKey.stale.delete_all"]
  env_from = ["contagorda/api"]

  env = {
    RAILS_ENV = "production"
  }

  successful_history_limit = 3
  failed_history_limit     = 5
}
