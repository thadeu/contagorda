# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.

# Ignore git directory.
/.git/
/.gitignore

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all default key files.
/config/master.key
/config/credentials/*.key

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore CI service files.
/.github

# Ignore development files
/.devcontainer

# Ignore Docker-related files
/.dockerignore

# `/Dockerfile*` used to be here, and it cannot be: voodu builds by tarballing
# this directory and then looking for the Dockerfile inside what arrived. A
# local `docker build` never notices the rule — the CLI reads the Dockerfile
# itself and hands it to the daemon out of band — so the exclusion only ever
# breaks the deploy, and breaks it two steps away from the cause: no Dockerfile,
# no image, and a release that reports a failed registry pull.
#
# The file ends up inside the image through `COPY . .`. It describes how the
# image was built and reveals nothing that the image does not already contain.
