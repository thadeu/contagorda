# The fallback, for a deploy that runs with `-r <remote>`. Copy to `.envrc`.
#
#   cp .envrc.example .envrc && direnv allow
#
# **The normal path does not need this file.** The manifests read their values
# from the controller:
#
#   vd config contagorda/pwa set \
#     VITE_API_URL="https://api.contagorda.com" \
#     VITE_CLOWK_PUBLISHABLE_KEY="pk_live_xxx"
#
# `env_from` makes the CLI fetch that bucket before parsing, so the placeholders
# in the manifest resolve from it. Rotating a key is one `vd config set` rather
# than a message to everybody who deploys.
#
# The catch: that lookup only runs for a **local** apply. With `-r <remote>` the
# CLI forwards over SSH and interpolation goes back to shell-only. So either
# deploy from the box, or keep these exported.
#
# Nothing secret belongs here or in that bucket. Vite inlines every `VITE_*`
# value into the bundle, so whatever goes in comes out readable by anyone who
# opens the app. The Clowk *secret* key is not here and never will be — it lives
# on the API side, through `vd config contagorda/api set`.

export VITE_API_URL="https://api.contagorda.com"

# Public by design: it ships in the bundle and doubles as the expected `aud` on
# tokens the API verifies.
export VITE_CLOWK_PUBLISHABLE_KEY="pk_live_xxx"

# The hostnames the ingresses answer on. Both have defaults in the manifests;
# override for a staging box.
export APP_HOST="app.contagorda.com"
export API_HOST="api.contagorda.com"
