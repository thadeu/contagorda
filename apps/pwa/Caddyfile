# Serving the built app.
#
# No TLS and no host matching here: this sits behind voodu's caddy ingress,
# which terminates https and knows the hostname. This one only answers with
# files.

# Port 80, because that is where voodu's ingress looks unless told otherwise —
# `upstream: pwa:80`. Meeting the default is one fewer thing to declare and one
# fewer pair of numbers to keep in step. Nothing is published to the host, so
# the port is not competing with anything.
:80 {
	# Plain http has to become https, and this is the only layer that can say so.
	#
	# The ingress serves :80 and :443 from one server with the same routes, so
	# Caddy's automatic redirect never fires — a TLS host stays reachable over
	# http and simply answers. For this app that is not cosmetic: on http the
	# origin the browser reports is `http://…`, which is what goes to Clowk as
	# the redirect_uri and gets refused, and every secure-context API —
	# `crypto.randomUUID`, Web Share, service workers — is absent rather than
	# broken. Installed to a home screen from http, it stays http forever.
	#
	# `X-Forwarded-Proto` is what the proxy in front sets, and the only way in
	# here to tell the two apart.
	@insecure {
		header X-Forwarded-Proto http
		not path /.well-known/acme-challenge/*
	}

	# The ACME path is excluded on purpose. The challenge arrives over http by
	# definition, and a redirect on it would break the renewal that keeps https
	# working — the failure would land 60 days later, on a certificate nobody
	# was watching.
	redir @insecure https://{host}{uri} 308

	root * /srv

	# Every path is the app. `/invite/<token>` and `/stats` belong to the
	# router, which cannot run until something has been served — so without this
	# they are 404s. The invite link is the case that makes it not optional: it
	# is the one URL somebody arrives at from outside.
	#
	# `public/_redirects` says this to Cloudflare Pages and `public/_headers`
	# says the rule below — Pages does not read a Caddyfile. All three have to
	# agree while both hosts are possible targets: forgetting one gives a bug
	# that reproduces on one host and not the other. See docs/pwa/hosting.md.
	try_files {path} /index.html

	# Hashed asset filenames can be cached forever; `index.html` cannot be cached
	# at all, or a returning phone keeps loading the old bundle and asking for
	# assets that a deploy has already removed.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	@shell path / /index.html /manifest.webmanifest
	header @shell Cache-Control "no-cache"

	encode gzip zstd
	file_server
}
