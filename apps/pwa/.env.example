# Copy to .env. All three are public — they ship in the browser bundle, so
# nothing secret belongs here. The Clowk secret key in particular stays on the
# API side and must never appear in this file.
VITE_CLOWK_PUBLISHABLE_KEY=pk_test_xxx
VITE_CLOWK_SUBDOMAIN_URL=https://your-instance.clowk.dev
VITE_API_URL=http://127.0.0.1:3000
