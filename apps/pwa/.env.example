# Copy to .env. All of these are public — they ship in the browser bundle, so
# nothing secret belongs here. The Clowk secret key in particular stays on the
# API side and must never appear in this file.
VITE_CLOWK_PUBLISHABLE_KEY=pk_test_xxx

# Optional. The publishable key already identifies the instance and the SDK
# resolves the URL from it; setting this skips that lookup, which is one fewer
# network hop before the app can open.
# VITE_CLOWK_SUBDOMAIN_URL=https://your-instance.clowk.dev

# Where the Rails API answers. No trailing slash and no `/api/v1` — the client
# adds the version itself, so the whole app moves between environments by
# changing a host.
#
# Optional in development: left out, the client uses port 3000 on whatever host
# served the app, which is what lets a phone on the network reach the API by
# the same LAN address it loaded the PWA from.
# VITE_API_URL=http://127.0.0.1:3000

# Set to `true` to run the app on fixtures instead of the API: no Rails, no
# Postgres, no sign-in that has to reach anywhere. Anything else, including
# leaving it out, talks to the API.
VITE_USE_MOCK=false
