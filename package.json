{
  "name": "contagorda",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "pnpm --filter @contagorda/pwa dev",
    "build": "pnpm --filter @contagorda/pwa build",
    "lint": "pnpm --filter @contagorda/pwa lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "dev:lp": "pnpm --filter @contagorda/lp dev",
    "build:lp": "pnpm --filter @contagorda/lp build",
    "deploy:lp": "pnpm --filter @contagorda/lp deploy:prod"
  }
}
