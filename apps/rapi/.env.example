# Copy to .env and fill in.

# Where Postgres is, and the only thing that decides it. The default in
# config/database.yml points at the compose container, so this is only needed to
# aim somewhere else.
# DATABASE_URL=postgres://contagorda:contagorda@127.0.0.1:5433/contagorda_development

# The cache is not a nicety here: every read is answered from it first, and the
# stamp that retires a value has to be visible to every Puma worker. Required in
# production, unused in development.
# REDIS_URL=redis://127.0.0.1:6379/0

# Which origins may call this API. A wildcard would let any site make
# authenticated calls with a token it coaxed out of a user.
# CORS_ORIGINS=https://app.contagorda.com

# Both come from the Clowk dashboard for this app's instance.
#
# The publishable key is public — it ships in the PWA bundle and doubles as the
# expected `aud` on incoming tokens. The secret key is not: it authenticates
# server-to-server calls to the Clowk API and never leaves the server.
CLOWK_PUBLISHABLE_KEY=pk_test_xxx
CLOWK_SECRET_KEY=sk_test_xxx

# The instance's auth domain. Set it explicitly so the gem does not resolve it
# through api.clowk.dev on the path that authenticates every request.
CLOWK_SUBDOMAIN_URL=https://your-instance.clowk.dev
