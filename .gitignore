node_modules/
dist/
dev-dist/
.turbo/
*.log
.DS_Store

.env
.env.*
!.env.example

# The test environment is declared, not inherited. Nothing in it is secret, and
# a suite whose behaviour depends on an untracked file is a suite that passes on
# one machine.
!.env.test

apps/pwa/.vite/
apps/rapi/tmp/
apps/rapi/log/
apps/rapi/storage/
apps/rapi/.bundle/

# Never commit master.key: it decrypts credentials, so a repo leak would become
# a credential leak.
apps/rapi/config/master.key
apps/rapi/config/credentials/*.key

# overmind writes its control socket here
.overmind.sock
