# The UI tests run on fixtures, and say so here rather than relying on the
# absence of a variable. A component test that reached for the API would need a
# Rails and a Postgres to be up before anyone could run `pnpm test`, and would
# fail for reasons that have nothing to do with the component.
#
# Checked in: nothing here is secret, and a test suite whose behaviour depends
# on an untracked file is a suite that passes on one machine.
VITE_USE_MOCK=true
VITE_API_URL=http://127.0.0.1:3000
VITE_CLOWK_PUBLISHABLE_KEY=pk_test_stub
VITE_CLOWK_SUBDOMAIN_URL=https://stub.clowk.dev
